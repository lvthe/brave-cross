# ---------------------------------------------------------------------------
# Nội dung của game — KHÔNG đưa lên repo.
#
# Đây là tài sản có bản quyền của bản gốc, và cũng quá lớn cho GitHub
# (riêng file .xapk đã 241 MB, vượt giới hạn 100 MB mỗi file).
# Repo này chỉ chứa công cụ, đặc tả rút ra được, và lớp offline tự viết.
#
# Muốn dựng lại từ đầu: đặt APK/XAPK vào thư mục gốc rồi làm theo
# work/README.md, mục "Cách chạy lại từ đầu".
# ---------------------------------------------------------------------------

*.apk
*.xapk
*.obb
*.dex
*.so
*.arsc

work/apk/
work/decrypted/
work/vn/

# unpack.py ghi manifest da giai nhi phan ra <out>/AndroidManifest.xml. Ban VN
# roi vao work/vn/ nen da bi chan o tren, ban CN thi roi thang vao work/ —
# van la noi dung dan xuat tu APK co ban quyen. Repo nay khong bao gio tu viet
# file nay nen chan han theo ten.
AndroidManifest.xml

# Project cua Ghidra — chua ca CSDL phan tich cua libgame.so (403 MB), tuc la
# noi dung dan xuat tu APK co ban quyen. Dung lai duoc bang cach import lai.
*.gpr
*.rep/
*.lock
*.lock~

# Kết quả build: nhúng chính file gốc của game (require.lua), sinh lại được
# bằng `python build.py`
work/offline/deploy/

# Rác
__pycache__/
*.pyc
*.bak
*.log

# Bản trung gian cũ, đã sai (488 API) — server-spec-vn/server_api.json thay thế
work/vn_api.json

# Bảng tham chiếu chéo sinh từ libgame.so — sinh lại bằng: python work/picmap.py
work/picmap.pkl

# Ảnh chụp màn hình game gốc, lấy bằng work/emu_dom.py để đối chiếu cách trộn
# (7,1 MB, 13 file) — là tài sản có bản quyền của bản gốc, cùng loại với
# *.apk ở trên. Chụp lại được bất cứ lúc nào, nên chặn hẳn.
work/_dom/

# Ảnh chụp màn hình bản gốc cho các phép đo thanh/vòng tiến độ (work/emu_pt.py,
# 30 MB) — cùng loại với work/_dom/ ở trên: là tài sản của bản gốc, và chụp lại
# được. Chặn hẳn để một lệnh `git add -A` không đẩy ảnh game lên repo.
work/_pt/

# Cây Lua đã vá để đẩy vào máy ảo của work/emu_anim.py (56 KB) — bên trong là
# bản sao `sc/game.lua` của game gốc, cùng loại với work/_dom/ ở trên. Dựng lại
# được bằng chính phép đo, nên chặn hẳn.
work/_emu_anim/

# Cây Lua đã vá + ảnh chụp màn hình + tombstone của các lượt dò chỗ đứng quân
# (work/emu_tran.py): `_tran/sc` và `_tran_dry/sc` là bản sao `sc/game.lua`,
# `sc/share/`, `sc/user/` của game gốc, còn `_tran/*.png` là ảnh của bản gốc —
# cùng loại với work/_dom/ và work/_emu_anim/ ở trên. Dựng lại được bằng chính
# phép đo, nên chặn hẳn để `git add -A` không đẩy chúng lên repo.
work/_tran/
work/_tran_dry/

# Bảng chỗ đọc/ghi trường của phép quét vtable CDFSpriteMove* (8 KB) — sinh lại
# bằng: python work/move_vt.py --json work/move_vt.json
work/move_vt.json

# Đồ thị lời gọi `bl` của libgame.so (2,3 MB, ~2,8 triệu lệnh Thumb) — sinh lại
# bằng: python work/blgraph.py --xay
work/blgraph.json

# Bãi nháp của các phép dò .xml: work/z.json là bản đổ của MỘT file .xml
work/z.json

# Bãi nháp mồ côi của một phép dò mô hình (442 KB): work/_h.json là bảng xương và
# điểm gắn của Hoplite, nhưng KHÔNG script nào trong work/ sinh hay đọc nó — nên
# không dựng lại được bằng lệnh nào. Chặn để `git add -A` không đẩy lên repo.
work/_h.json
